 "PARTICLES": {
  "NI": {
   "role": "object",
   "gloss": "marks what the deed is done to: IO SIVA NI UDA, I drink water"
  },
  "TE": {
   "role": "context",
   "gloss": "ends a setting: NIKTA TE, IO LUNO, at night, I rest"
  },
  "O": {
   "role": "address",
   "gloss": "before a deed, a command (O SIVA, drink); after a name, a call (AMI O, kin)"
  },
  "KE": {
   "role": "question",
   "gloss": "stands where the unknown would: TU KE? what are you?"
  },
  "SU": {
   "role": "regroup",
   "gloss": "of: the modifiers after it modify as one, HEMA-SU-HOMA-MEGA, the home of the great one"
  },
  "TA": {
   "role": "and",
   "gloss": "joins two who do, or two that are done to: IO TA TU KITH, you and I, together"
  },
  "VE": {
   "role": "or",
   "gloss": "between two choices; a yes-or-no question is SIVA VE SIVA-VOYD?"
  },
  "SED": {
   "role": "but",
   "gloss": "opens a sentence that turns against the last: IO SIVA. SED UDA VOYD. I drink. But there is no water."
  }
 },
